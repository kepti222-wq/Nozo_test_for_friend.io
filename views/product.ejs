<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<%- include ('blocks/header.ejs') -%>  


<div class="container product-page  ">


  <div class="product-left">
  
    <img src="<%= product.logo %>" alt="<%= product.name %>" class="product_img">
  </div>

    
    
    



  <div class="product-middle">
     <h2 class="product_name"><%= product.name %></h2>


        <% if (specs && specs.length > 0) { %>
        <div class="product_specs">
          <h3 class="specs_title">О товаре</h3>
          <ul class="specs_list">
            <% specs.forEach(spec => { %>
              <li class="specs_item">
                
                  <span class="specs_name"><%= spec.name %></span>
                  <span class="specs_value"><%= spec.value %></span>
                
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>

  </div>


    <div class="product-right">

      <div class="product-info">
        <p>
          <img class="copy_img" src="/img/copy.png">
          артикул: <%= product.article %>
        </p>

        <p>
          <img class="list_img" src="/img/list.png">
           в сравнение
        </p>
        <p class="copy_link" data-clipboard-text="http://localhost:3000/product/<%= product.article %>">
          <i class="fa-solid fa-share"></i> поделиться 
        </p>
        
      </div>
      
      <div class="product_acide">

        <div class="price-row">

        <span class="product_price"><%= product.price %> ₽</span>
        <span class="product_after_price"> 
        с картой NOZO банка
        <img class="nozo_bank" src="/img/nozo_bank.png"></span>     

       </div>

      <div class="price-row">
        <span class="sale_price"><%= product.sale_Price %> ₽</span>
        <span class="product_after_sale_price">С другими банками</span> 
      </div>
            
      <button id="perehochez">хочу скидку</button>

        <div class="buttons">
          <button 
          class="add_to_cart" 
          id="addToCartBtn"
          data-article="<%= product.article %>"
          data-name="<%= product.name %>"
          data-price="<%= product.sale_Price || product.price %>"
          data-logo="<%= product.logo %>"
          >в корзину</button>

          <button class="favorite" id="favoriteBtn" data-article="<%= product.article %>">
          <i class="fa-regular fa-heart "></i>
          </button>
        </div>
    </div>
    
    <div class="product-ad">
      <img src="/img/AD/<%= randomAd %>" alt="Реклама" class="product-ad-img">
    </div>

  </div>
</div>

<section class="recommended">
  <h2 class="recommended-title">Вам также может понравиться</h2>
  <%- productsHtml %>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.11/clipboard.min.js"></script>
<script src="/js/cart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    new ClipboardJS('.copy_link');

    const cartBtn = document.getElementById('addToCartBtn');
    if (cartBtn) {

      cartBtn.addEventListener('click', () => {
        const product = {
          article: cartBtn.dataset.article,
          name: cartBtn.dataset.name,
          price: cartBtn.dataset.price,
          logo: cartBtn.dataset.logo,
    };
    NozoCart.addToCart(product);
    cartBtn.textContent = 'в корзине ✓';
    cartBtn.disabled = true;
  });
}





  const favBtn = document.getElementById('favoriteBtn');
  if (favBtn) {
    const article = favBtn.dataset.article;
    const icon = favBtn.querySelector('i');
    if (NozoCart.isFavorite(article)) {
        favBtn.classList.add('active');
        icon.className = 'fa-solid fa-heart';
      }
    favBtn.addEventListener('click', () => {
      const nowFav = NozoCart.toggleFavorite(article);
      favBtn.classList.toggle('active', nowFav);
      icon.className = nowFav ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
    });
  }

  const perehochez = document.getElementById('perehochez');
  if (perehochez) {
    perehochez.addEventListener('click', () => {
      perehochez.textContent = 'перехочешь :P';
      perehochez.disabled = true;
    });
  }
});
</script>

</body>
</html>